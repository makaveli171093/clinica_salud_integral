{
  "name": "PROYECTO_CLINICA_SALUD_INTEGRAL",
  "version": "0.2.0",
  "description": "API de la Clinica Salud Integral",
  "scripts": {
    "generate": "prisma generate --no-hints --config prisma.config.ts",
    "build": "pnpm generate && tsc -p tsconfig.json",
    "dev": "pnpm build && node --watch dist/main.js",
    "start": "node dist/main.js",
    "check": "pnpm generate && tsc --noEmit -p tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs",
    "admin:create": "node --import tsx scripts/create-admin.ts",
    "db:deploy": "prisma migrate deploy --config prisma.config.ts",
    "test:db": "node --test test/prisma.integration.mjs",
    "db:seed": "node --import tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.25.0",
  "type": "module",
  "dependencies": {
    "@fastify/helmet": "^13.1.2",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.11.3",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.7",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  }
}
